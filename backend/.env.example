OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash
PORT=3000
NODE_ENV=development

# Set this in production and pass the same value to Flutter as BACKEND_CLIENT_TOKEN.
BACKEND_CLIENT_TOKEN=change_this_long_random_value

# Production behind HTTPS should set ENFORCE_HTTPS=true.
ENFORCE_HTTPS=false
TRUST_PROXY=false

# Optional app integrity scaffold. Production should replace APP_INTEGRITY_TOKEN
# with Firebase App Check or Play Integrity verification.
REQUIRE_APP_INTEGRITY=false
APP_INTEGRITY_TOKEN=change_this_if_integrity_is_required

# Comma-separated browser origins if a web client is added. Empty disables CORS browser access.
CORS_ALLOWED_ORIGINS=

# Request abuse controls.
REQUEST_BODY_LIMIT=12mb
MAX_SELECTED_FRAMES=3
MAX_ALL_FRAMES=30
MAX_BASE64_IMAGE_BYTES=5242880
MAX_IMAGE_BASE64_LENGTH=3500000
MAX_USER_COMMAND_CHARS=500
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
RATE_LIMIT_MAX_REQUESTS=20
VISION_RATE_LIMIT_MAX=10
DAILY_QUOTA_MAX_REQUESTS=1000
OPENROUTER_TIMEOUT_MS=30000
